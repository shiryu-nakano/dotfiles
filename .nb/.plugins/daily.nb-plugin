#!/usr/bin/env bash
###############################################################################
# daily.nb-plugin
#
# Create daily log notes with section copying from previous day.
# Inspired by org-roam daily workflow.
#
# Install with:
#   nb plugins install ~/.nb/.plugins/daily.nb-plugin
#
# Usage:
#   nb daily          - Create/open today's daily note
#   nb daily yesterday - Open yesterday's daily note
#   nb daily YYYY-MM-DD - Open specific date's daily note
###############################################################################

_subcommands add "daily"

_subcommands describe "daily" <<HEREDOC
Usage:
  nb daily [<date>] [--no-edit]

Options:
  --no-edit  Create the file without opening in editor.

Arguments:
  <date>     Optional date in YYYY-MM-DD format, or "yesterday".
             Defaults to today.

Description:
  Create or open a daily log note.
  When creating a new note, copies the previous day's note and
  updates the frontmatter (title and created date).
  If no previous note exists, creates from a default template.

  File structure:
    daily/YYYY/MM/YYYY-MM-DD.md

Examples:
  nb daily              Create/open today's note
  nb daily yesterday    Open yesterday's note
  nb daily 2026-03-01   Open note for March 1, 2026
HEREDOC

# Find the most recent previous daily note
# Usage: _daily_find_previous_note <notebook_path> <target_date> [<max_days>]
# Returns: path to the most recent previous note, or empty string if none found
_daily_find_previous_note() {
  local _notebook_path="${1}"
  local _target_date="${2}"
  local _max_days="${3:-30}"
  local _check_date=""
  local _check_file=""

  for (( i=1; i<=_max_days; i++ )); do
    # Calculate date i days before target
    if command -v gdate &>/dev/null; then
      _check_date="$(gdate -d "${_target_date} - ${i} day" +%Y-%m-%d)"
    elif date -v-1d &>/dev/null 2>&1; then
      # macOS date
      _check_date="$(date -j -f "%Y-%m-%d" "${_target_date}" -v-${i}d +%Y-%m-%d 2>/dev/null)"
    else
      # GNU date
      _check_date="$(date -d "${_target_date} - ${i} day" +%Y-%m-%d)"
    fi

    local _check_year="${_check_date:0:4}"
    local _check_month="${_check_date:5:2}"
    _check_file="${_notebook_path}/daily/${_check_year}/${_check_month}/${_check_date}.md"

    if [[ -f "${_check_file}" ]]; then
      printf "%s" "${_check_file}"
      return 0
    fi
  done

  # No previous note found
  return 0
}

# Generate default daily note content
_daily_default_template() {
  cat <<'EOF'
# Home

# 直近の予定締め切り

# TASK

# LOG

# タスク整理

# Agile

小さなプロジェクトor習慣化
プロジェクトごとにメモをため、大きくなったらprojectにするか、もしくはnoteにまとめておく

## MISC

## Engineer働き方

## 研究

## Math Study

## 音楽

## Reading

# 所感

# inbox

EOF
}

_daily() {
  local _date_arg="${1:-}"
  local _no_edit=0
  local _target_date=""
  local _notebook_path=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --no-edit)
        _no_edit=1
        shift
        ;;
      yesterday)
        _target_date="$(date -v-1d +%Y-%m-%d 2>/dev/null || date -d 'yesterday' +%Y-%m-%d)"
        shift
        ;;
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
        _target_date="${1}"
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  # Default to today
  if [[ -z "${_target_date}" ]]; then
    _target_date="$(date +%Y-%m-%d)"
  fi

  # Extract year and month
  local _year="${_target_date:0:4}"
  local _month="${_target_date:5:2}"

  # Get notebook path
  _notebook_path="$(_notebooks current --path)"

  # Build file path
  local _daily_dir="${_notebook_path}/daily/${_year}/${_month}"
  local _daily_file="${_daily_dir}/${_target_date}.md"

  # Find the most recent previous daily note for section copying
  local _previous_file=""
  _previous_file="$(_daily_find_previous_note "${_notebook_path}" "${_target_date}" 3)"

  # Create directory if needed
  mkdir -p "${_daily_dir}"

  # If file doesn't exist, create it
  if [[ ! -f "${_daily_file}" ]]; then
    printf "Creating daily note for %s...\\n" "${_target_date}"

    if [[ -n "${_previous_file}" ]]; then
      printf "  Copying from: %s\\n" "$(basename "${_previous_file}")"
      # Copy previous note and update frontmatter
      sed "s/^title: \".*\"/title: \"${_target_date}\"/; s/^created: .*/created: $(date +%Y-%m-%dT%H:%M:%S)/" \
        "${_previous_file}" > "${_daily_file}"
    else
      printf "  No previous daily note found, using defaults.\\n"
      # Create from default template
      cat > "${_daily_file}" <<EOF
---
title: "${_target_date}"
tags: [daily]
created: $(date +%Y-%m-%dT%H:%M:%S)
---

EOF
      _daily_default_template >> "${_daily_file}"
    fi

    # Git checkpoint
    if [[ -n "$(_git status --porcelain 2>/dev/null)" ]]; then
      _git checkpoint "[nb] Daily note: ${_target_date}"
    fi

    printf "Created: %s\\n" "${_daily_file}"
  else
    printf "Opening existing daily note for %s...\\n" "${_target_date}"
  fi

  # Open in editor
  if [[ "${_no_edit}" -eq 0 ]]; then
    nvim "${_daily_file}"
  fi
}
