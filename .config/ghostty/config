# Ghostty Config - WezTerm風設定

# ===== フォント設定 =====
font-family = "JetBrainsMono Nerd Font"
# font-family = "Fira Code"  # 代替フォント
font-size = 12
font-feature = calt
font-feature = liga

# ===== ウィンドウ設定 =====
window-padding-x = 10
window-padding-y = 10
window-decoration = true
window-theme = ghostty

# 背景透明度（WezTerm風）
background-opacity = 0.95

# ===== カラースキーム（WezTermデフォルト風） =====
# 背景・前景
background = #000000
foreground = #ffffff

# カーソル
cursor-color = #c0caf5
cursor-style = block
cursor-style-blink = true

# 選択
selection-background = #33467c
selection-foreground = #c0caf5

# ANSIカラー（TokyoNight風 - WezTermでよく使われる）
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# ===== キーバインド（Ubuntu用 - ctrlベース） =====
# タブ操作
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+shift+right_bracket=next_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# ペイン分割
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:top
keybind = ctrl+alt+down=goto_split:bottom

# ペインサイズ調整
keybind = ctrl+shift+left=resize_split:left,20
keybind = ctrl+shift+right=resize_split:right,20
keybind = ctrl+shift+up=resize_split:up,20
keybind = ctrl+shift+down=resize_split:down,20

# フォントサイズ
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# コピー・ペースト
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+shift+c=text:\x03
keybind = ctrl+v=paste_from_clipboard

# クリア
keybind = ctrl+k=clear_screen

# ===== その他 =====
confirm-close-surface = false
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-paste-protection = false

# スクロールバック
scrollback-limit = 10000

# ベル音無効
shell-integration-features = no-cursor,no-title
command = /usr/bin/zsh
