#!/usr/bin/env bash
# クリップボードの画像を一時ファイルに保存し、パスを出力する

mime=$(wl-paste --list-types 2>/dev/null | grep -m1 'image/')
if [ -n "$mime" ]; then
  ext="${mime#image/}"
  tmpfile="/tmp/clipboard_$(date +%Y%m%d_%H%M%S).${ext}"
  wl-paste --type "$mime" > "$tmpfile" 2>/dev/null
  printf '%s' "$tmpfile"
else
  # 画像がなければ通常のテキストをペースト
  wl-paste 2>/dev/null
fi
